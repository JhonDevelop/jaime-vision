# ── Jaime — copie para .env e preencha. NUNCA comite o .env. ──

# Obrigatório
ANTHROPIC_API_KEY=
JAIME_MODEL=claude-opus-5

# Cérebro / trabalho
JAIME_VAULT=./vault
JAIME_WORKSPACE=~/projetos

# Acesso (hash SHA-256 da palavra-passe; o padrão do código é "12341234")
JAIME_PASSPHRASE_HASH=1718c24b10aeb8099e3fc44960ab6949ab76a267352459f203ea1036bec382c2
JAIME_ACESSO_TIMEOUT_MIN=30

# Servidor local (não exponha fora da máquina sem saber o que está fazendo)
JAIME_BIND=127.0.0.1
JAIME_PORT=8787
JAIME_SERVER_TOKEN=troque-isto
JAIME_THINKING_TOKENS=4000

# Cérebro compartilhado — Notion (integração interna com acesso à página raiz)
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=3db6fab2-88b8-8180-bbe0-dfd72b7f58ff
NOTION_DB_DIARIO=4f742e96b84140c0a475f857d0d95502
NOTION_DB_TAREFAS=52224d3a0f6d40f0a4e46eaee885c074
NOTION_DB_CONVERSAS=714d55db72a3428db267940cdf7ba757

# Voz (opcional — fase 3)
PICOVOICE_ACCESS_KEY=
JAIME_WAKE_WORD=jarvis
JAIME_WAKE_PPN=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Elvis (zNEsdgTUa3ndwKry8Xcq) e as outras vozes brasileiras são 'professional': o plano free devolve 402 via API.
# Premade grave em inglês, fala pt-BR com sotaque. Com o Starter, volte para a brasileira.
ELEVENLABS_VOICE_ID=

# WhatsApp (opcional — fase 4)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=jaime
JAIME_OWNER_PHONE=

# Cérebro alternativo (OpenAI)
OPENAI_API_KEY=

# Escuta contínua (sem wake word) — liga junto com o HUD
JAIME_VOZ=on
JAIME_WHISPER_MODELO=base
JAIME_SAY_VOZ=Eddy (Português (Brasil))
JAIME_TTS_MODELO=eleven_flash_v2_5

# Ativação por voz: nome = só responde a 'Jaime, …' (janela de 90 s depois); sempre = responde a tudo
JAIME_ATIVACAO=nome
JAIME_NOME=jaime
JAIME_JANELA_ATIVA_S=25

# Córtex — quem pensa em cada tipo de tarefa (docs/FASE-2-JARVIS.md §2.1)
JAIME_MODEL_DECISAO=claude-fable-5-1
JAIME_MODEL_CODIGO=claude-opus-5
JAIME_MODEL_PADRAO=claude-sonnet-5
JAIME_MODEL_ROTINA=claude-haiku-4-5-20251001
JAIME_CORTEX_EXPLORACAO=0.10
# OpenAI (lista real em 15/09/2026: gpt-5.5, gpt-5.6-luna, gpt-5.6-sol, gpt-realtime-2, gpt-4o-mini-tts, gpt-image-2.5-*)
JAIME_OPENAI_MODEL=gpt-5.5
JAIME_OPENAI_MODEL_RAPIDO=gpt-5.6-luna

# Onde o João está (clima pela Open-Meteo, sem chave). Padrão: Franca/SP
JAIME_LAT=-20.5386
JAIME_LON=-47.4008

# Conexões (fase 2, etapa 8) — ver docs/CONEXOES.md
# Google: credencial "Desktop" do SEU projeto no Google Cloud (arquivo JSON baixado do console)
GOOGLE_CLIENT_SECRET_FILE=~/Jaime/google-client-secret.json
GOOGLE_TOKEN_FILE=~/Jaime/google-token.json
# Telegram: token do bot (@BotFather) e o SEU id numérico (@userinfobot) — só ele conversa com o Jaime
TELEGRAM_BOT_TOKEN=
JAIME_OWNER_TELEGRAM_ID=

# Motor de voz: openai (gpt-4o-mini-tts, voz onyx, instrução de estilo pelo humor) | elevenlabs | auto (ElevenLabs se houver cota, senão OpenAI, senão say)
JAIME_TTS=openai
JAIME_OPENAI_VOZ=onyx
JAIME_OPENAI_TTS_MODELO=gpt-4o-mini-tts
