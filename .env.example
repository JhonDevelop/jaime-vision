# Jaime — modelo de configuração.
#
#   cp .env.example .env    e preencha o .env (que nunca é commitado).
#
# Só a ANTHROPIC_API_KEY é obrigatória para `python -m jaime chat`.
# O resto liga funcionalidades: vazio = desligado, sem quebrar o Jaime.
# Os valores abaixo são exemplos com o formato esperado, nunca chaves reais.

# ── núcleo (obrigatório) ───────────────────────────────
# Chave da API da Anthropic. Lida pelo Agent SDK.
ANTHROPIC_API_KEY=

# Modelo do orquestrador: sonnet | opus | haiku, ou um id completo.
JAIME_MODEL=sonnet

# ── cérebro ────────────────────────────────────────────
# Vault Obsidian: a memória de longo prazo. Relativo ao repo ou absoluto.
JAIME_VAULT=./vault

# Onde o maester-dev procura os repositórios do João.
JAIME_WORKSPACE=~/projetos

# ── voz (opcional — fase 3) ────────────────────────────
# Porcupine/Picovoice, para a wake word. console.picovoice.ai
PICOVOICE_ACCESS_KEY=

# Wake word built-in. "jarvis" funciona sem treino; "jaime" exige um .ppn.
JAIME_WAKE_WORD=jarvis

# Caminho para um .ppn treinado. Preenchido, tem precedência sobre JAIME_WAKE_WORD.
JAIME_WAKE_PPN=

# STT: com chave usa Deepgram (nova-3, pt-BR); sem chave, faster-whisper local.
DEEPGRAM_API_KEY=

# TTS: sem chave, o Jaime imprime a fala no terminal — dá para testar sem áudio.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── WhatsApp (opcional — fase 4) ───────────────────────
# Evolution API, para o número pessoal.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=jaime

# Número do dono, com país e DDD, só dígitos. Ex: 5516999999999
# Mensagem de outro número vira linha de diário, nunca ordem.
JAIME_OWNER_PHONE=

# ── servidor (fase 4 e n8n) ────────────────────────────
# Token do header X-Jaime-Token em POST /ask e /webhook/whatsapp.
# TROQUE antes de expor a porta 8787. Gere com: openssl rand -hex 32
JAIME_SERVER_TOKEN=troque-isto
