# ── Jaime — copie para .env e preencha. NUNCA comite o .env. ──

# Obrigatório
ANTHROPIC_API_KEY=
JAIME_MODEL=claude-opus-5

# Cérebro / trabalho
JAIME_VAULT=./vault
JAIME_WORKSPACE=~/projetos

# Acesso (hash SHA-256 da palavra-passe; o padrão do código é "12341234")
JAIME_PASSPHRASE_HASH=1718c24b10aeb8099e3fc44960ab6949ab76a267352459f203ea1036bec382c2
JAIME_ACESSO_TIMEOUT_MIN=30

# Servidor local (não exponha fora da máquina sem saber o que está fazendo)
JAIME_BIND=127.0.0.1
JAIME_PORT=8787
JAIME_SERVER_TOKEN=troque-isto
JAIME_THINKING_TOKENS=4000

# Cérebro compartilhado — Notion (integração interna com acesso à página raiz)
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=3db6fab2-88b8-8180-bbe0-dfd72b7f58ff
NOTION_DB_DIARIO=4f742e96b84140c0a475f857d0d95502
NOTION_DB_TAREFAS=52224d3a0f6d40f0a4e46eaee885c074
NOTION_DB_CONVERSAS=714d55db72a3428db267940cdf7ba757

# Voz (opcional — fase 3)
PICOVOICE_ACCESS_KEY=
JAIME_WAKE_WORD=jarvis
JAIME_WAKE_PPN=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Elvis (zNEsdgTUa3ndwKry8Xcq) e as outras vozes brasileiras são 'professional': o plano free devolve 402 via API.
# Premade grave em inglês, fala pt-BR com sotaque. Com o Starter, volte para a brasileira.
ELEVENLABS_VOICE_ID=

# WhatsApp (opcional — fase 4)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=jaime
JAIME_OWNER_PHONE=

# Cérebro alternativo (OpenAI)
OPENAI_API_KEY=

# Escuta contínua (sem wake word) — liga junto com o HUD
JAIME_VOZ=on
JAIME_WHISPER_MODELO=base
JAIME_SAY_VOZ=Eddy (Português (Brasil))
JAIME_TTS_MODELO=eleven_flash_v2_5

# Ativação por voz: nome = só responde a 'Jaime, …' (janela de 90 s depois); sempre = responde a tudo
JAIME_ATIVACAO=nome
JAIME_NOME=jaime
JAIME_JANELA_ATIVA_S=25

# Córtex — quem pensa em cada tipo de tarefa (docs/FASE-2-JARVIS.md §2.1)
JAIME_MODEL_DECISAO=claude-fable-5-1
JAIME_MODEL_CODIGO=claude-opus-5
JAIME_MODEL_PADRAO=claude-sonnet-5
JAIME_MODEL_ROTINA=claude-haiku-4-5-20251001
JAIME_CORTEX_EXPLORACAO=0.10
# OpenAI (lista real em 15/09/2026: gpt-5.5, gpt-5.6-luna, gpt-5.6-sol, gpt-realtime-2, gpt-4o-mini-tts, gpt-image-2.5-*)
JAIME_OPENAI_MODEL=gpt-5.5
JAIME_OPENAI_MODEL_RAPIDO=gpt-5.6-luna

# Onde o João está (clima pela Open-Meteo, sem chave). Padrão: Franca/SP
JAIME_LAT=-20.5386
JAIME_LON=-47.4008

# Conexões (fase 2, etapa 8) — ver docs/CONEXOES.md
# Google: credencial "Desktop" do SEU projeto no Google Cloud (arquivo JSON baixado do console)
GOOGLE_CLIENT_SECRET_FILE=~/Jaime/google-client-secret.json
GOOGLE_TOKEN_FILE=~/Jaime/google-token.json
# Telegram: token do bot (@BotFather) e o SEU id numérico (@userinfobot) — só ele conversa com o Jaime
TELEGRAM_BOT_TOKEN=
JAIME_OWNER_TELEGRAM_ID=

# Motor de voz: openai (gpt-4o-mini-tts, voz onyx, instrução de estilo pelo humor) | elevenlabs | auto (ElevenLabs se houver cota, senão OpenAI, senão say)
JAIME_TTS=openai
JAIME_OPENAI_VOZ=onyx
JAIME_OPENAI_TTS_MODELO=gpt-4o-mini-tts

# Imagens (OpenAI) e 3D
JAIME_OPENAI_IMAGEM=gpt-image-2.5-flare
JAIME_BLENDER=/Applications/Blender.app/Contents/MacOS/Blender

# Meta (fase 2, etapa 11) — WhatsApp Cloud API (número comercial) e Instagram Messaging (conta profissional). Ver docs/CONEXOES.md
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=troque-isto-tambem
META_WHATSAPP_PHONE_ID=
META_INSTAGRAM_ACCOUNT_ID=
# Evolution API (WhatsApp pessoal) passou a ser OPCIONAL — risco de bloqueio da conta; prefira a Cloud API.

# Modo autônomo (fase 2, etapa 12)
JAIME_AUTONOMO_HORAS=2
JAIME_AUTONOMO_CUSTO_USD=5
JAIME_AUTONOMO_FERRAMENTAS=Read,Write,Edit,Bash,Glob,Grep,WebSearch,WebFetch

# Fase 3 — modo de voz: pipeline (padrão, econômico) | conversa (GPT-Realtime-2 fala-para-fala, ~US$ 0,3/min)
JAIME_VOZ_MODO=pipeline
JAIME_REALTIME_MODEL=gpt-realtime-2
JAIME_REALTIME_VOZ=cedar

# Fase 3.4 — casa: Home Assistant (token de acesso de longa duração) e câmera
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
JAIME_CAMERA=0   # índice do dispositivo avfoundation (0 = FaceTime) ou entity_id de câmera do HA (camera.entrada)

# Fase 3.5 — visão contínua (jogos/apps): limites
JAIME_VISAO_MAX_PASSOS=60
JAIME_VISAO_INTERVALO_S=2

# Quanto usar a OpenAI: minimo (só TTS onyx, imagens sob pedido e 'pensa bem' explícito) | normal (roteador em pesquisa/redação + juiz em decisões)
JAIME_OPENAI_USO=minimo

# Reconhecimento de quem fala (João/Gabriel): on | off — roda num processo separado (jaime/voice/falantes_worker.py)
JAIME_FALANTES=on

# ── Fase 3: tempo real (docs/FASE-3-TEMPO-REAL.md) ──
# duplex (padrão): STT em streaming + antecipador + barge-in | pipeline: turno a turno | conversa: Realtime fala-para-fala
JAIME_VOZ_MODO=duplex
# STT em streaming: deepgram | openai | local | auto (Deepgram se houver chave, senão OpenAI Realtime, senão Whisper local)
JAIME_STT_STREAM=auto
# modelo rápido do antecipador (vazio = JAIME_OPENAI_MODEL_RAPIDO; off = só heurística local)
JAIME_ANTECIPADOR_MODEL=
# barge-in (o João corta o Jaime): on | off | fone (sem guarda de eco — use com fone de ouvido)
JAIME_BARGE_IN=on
# o Jaime interrompe o João com uma interjeição curta quando ele hesita (desligado até o antecipador estar calibrado)
JAIME_INTERROMPER=0
# velocidade da voz (1.15–1.25 soa natural e mais ágil)
JAIME_VOZ_VELOCIDADE=1.15

# ── Fase 3: telemetria, orçamento, vontades, filhos ──
# orçamento diário em dólares (0 = sem limite); dividido 60% demandas · 25% estudo · 15% criação (01-Estado/Orcamento.md)
JAIME_ORCAMENTO_DIA_USD=0
# telemetria local da janela ativa a cada 30 s → 01-Estado/Uso.md (nunca vai ao Notion); apps excluídos separados por vírgula
JAIME_TELEMETRIA=1
JAIME_TELEMETRIA_EXCLUIR=1Password,Senhas,Mensagens
# noite criativa (21h–06h): on/off e quantas criações por noite → ~/Jaime/criacoes e Vitrine do HUD
JAIME_CRIACOES=on
JAIME_CRIACOES_POR_NOITE=1
# filhos no Maestri: máximo vivos ao mesmo tempo; socket/terminal do Maestro (descobertos sozinhos se vazios)
JAIME_FILHOS_MAX=4
JAIME_MAESTRI_SOCKET=
JAIME_MAESTRI_TERMINAL_ID=
