{
  "name": "Jaime — Ponte WhatsApp (Evolution API)",
  "nodes": [
    {
      "parameters": {"httpMethod": "POST", "path": "jaime-whatsapp", "responseMode": "onReceived", "options": {}},
      "id": "b1", "name": "Webhook Evolution", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0],
      "webhookId": "jaime-whatsapp"
    },
    {
      "parameters": {"assignments": {"assignments": [
        {"id": "d1", "name": "jaime_url", "value": "https://SEU-TUNEL.trycloudflare.com", "type": "string"},
        {"id": "d2", "name": "jaime_token", "value": "troque-isto", "type": "string"},
        {"id": "d3", "name": "evolution_url", "value": "https://evo.seudominio.com", "type": "string"},
        {"id": "d4", "name": "evolution_key", "value": "SUA-APIKEY-EVOLUTION", "type": "string"},
        {"id": "d5", "name": "evolution_instance", "value": "jaime", "type": "string"},
        {"id": "d6", "name": "owner_phone", "value": "5516999999999", "type": "string"}
      ]}, "includeOtherFields": true, "options": {}},
      "id": "b2", "name": "Config", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [220, 0]
    },
    {
      "parameters": {"jsCode": "const body = $input.first().json.body || $input.first().json;\nconst data = body.data || {};\nconst key = data.key || {};\nif (key.fromMe) return [];\nconst numero = String(key.remoteJid || '').split('@')[0];\nconst m = data.message || {};\nconst texto = m.conversation || (m.extendedTextMessage && m.extendedTextMessage.text) || '';\nif (!numero || !texto) return [];\nconst cfg = $('Config').first().json;\nreturn [{ json: { numero, texto, eh_dono: numero.startsWith(cfg.owner_phone) } }];"},
      "id": "b3", "name": "Extrair mensagem", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [440, 0]
    },
    {
      "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
        "conditions": [{"id": "e1", "leftValue": "={{ $json.eh_dono }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}],
        "combinator": "and"}, "options": {}},
      "id": "b4", "name": "É o dono?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST", "url": "={{ $('Config').item.json.jaime_url }}/ask",
        "sendHeaders": true, "headerParameters": {"parameters": [{"name": "X-Jaime-Token", "value": "={{ $('Config').item.json.jaime_token }}"}]},
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ { texto: $json.texto, canal: 'whatsapp' } }}",
        "options": {"timeout": 120000}
      },
      "id": "b5", "name": "Perguntar ao Jaime", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [880, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.evolution_url }}/message/sendText/{{ $('Config').item.json.evolution_instance }}",
        "sendHeaders": true, "headerParameters": {"parameters": [{"name": "apikey", "value": "={{ $('Config').item.json.evolution_key }}"}]},
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ { number: $('Extrair mensagem').item.json.numero, text: $json.resposta } }}",
        "options": {}
      },
      "id": "b6", "name": "Responder no WhatsApp", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1100, -100]
    },
    {
      "parameters": {
        "method": "POST", "url": "={{ $('Config').item.json.jaime_url }}/ask",
        "sendHeaders": true, "headerParameters": {"parameters": [{"name": "X-Jaime-Token", "value": "={{ $('Config').item.json.jaime_token }}"}]},
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ { texto: 'registra: WhatsApp de ' + $json.numero + ' — ' + $json.texto.slice(0, 200) + '. Não responda a ele; só anote no diário e, se for cliente, crie uma tarefa.', canal: 'n8n' } }}",
        "options": {"timeout": 60000}
      },
      "id": "b7", "name": "Só registrar (terceiros)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [880, 120]
    }
  ],
  "connections": {
    "Webhook Evolution": {"main": [[{"node": "Config", "type": "main", "index": 0}]]},
    "Config": {"main": [[{"node": "Extrair mensagem", "type": "main", "index": 0}]]},
    "Extrair mensagem": {"main": [[{"node": "É o dono?", "type": "main", "index": 0}]]},
    "É o dono?": {"main": [[{"node": "Perguntar ao Jaime", "type": "main", "index": 0}], [{"node": "Só registrar (terceiros)", "type": "main", "index": 0}]]},
    "Perguntar ao Jaime": {"main": [[{"node": "Responder no WhatsApp", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1", "timezone": "America/Sao_Paulo"},
  "active": false
}
